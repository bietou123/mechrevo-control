{
  "name": "mechrevo-control",
  "productName": "MECHREVO Control",
  "version": "1.2.1",
  "description": "MECHREVO Z3 Pro 电竞控制台重设计（桌面版）",
  "main": "main.js",
  "author": "bietou123",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable -c.electronDist=node_modules/electron/dist"
  },
  "build": {
    "appId": "com.bietou123.mechrevo-control",
    "productName": "MECHREVO Control",
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "index.html",
      "style.css",
      "app.js",
      "main.js",
      "preload.js",
      "ec.js",
      "mqtt.js",
      "assets/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "asarUnpack": [
      "node_modules/koffi/**"
    ],
    "portable": {
      "artifactName": "MECHREVO-Control-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^40.10.6",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "koffi": "^3.3.7"
  }
}
